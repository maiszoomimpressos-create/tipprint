<?xml version="1.0" encoding="utf-8"?>
<!--
  TipPrint · CLEAR — tela de configurações
  Tokens: design/tipprint-tokens.json (tipprint_*)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tipprint_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Marca -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_xs">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo_tipprint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    style="@style/TextAppearance.TipPrint.Headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    style="@style/TextAppearance.TipPrint.Overline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sobre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xs"
            style="@style/TextAppearance.TipPrint.Overline"
            android:text="@string/settings_about" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md"
            style="@style/TextAppearance.TipPrint.Body"
            android:text="@string/settings_about_text" />

        <!-- Identidade visual -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xs"
            style="@style/TextAppearance.TipPrint.Overline"
            android:text="@string/settings_identity" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md"
            style="@style/TextAppearance.TipPrint.Body"
            android:text="@string/settings_identity_text" />

        <!-- Impressão -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xs"
            style="@style/TextAppearance.TipPrint.Overline"
            android:text="@string/settings_printing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md"
            style="@style/TextAppearance.TipPrint.Mono"
            android:text="@string/settings_printing_text" />

        <!-- Atualizações -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_xs"
            style="@style/TextAppearance.TipPrint.Overline"
            android:text="@string/settings_updates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md"
            style="@style/TextAppearance.TipPrint.Body"
            android:text="@string/settings_updates_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs"
            style="@style/TextAppearance.TipPrint.Caption"
            android:text="@string/label_update_server" />

        <EditText
            android:id="@+id/updateServerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md"
            android:hint="http://192.168.0.10:3005"
            style="@style/TextAppearance.TipPrint.Mono" />

        <Button
            android:id="@+id/saveUpdateServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/save_update_server" />

        <Switch
            android:id="@+id/autoUpdateSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/settings_auto_update" />

        <Button
            android:id="@+id/checkUpdatesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/settings_check_updates" />

        <!-- Versão -->
        <TextView
            android:id="@+id/settingsVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            style="@style/TextAppearance.TipPrint.Caption"
            android:text="" />

    </LinearLayout>
</ScrollView>