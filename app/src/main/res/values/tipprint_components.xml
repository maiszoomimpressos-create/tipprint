<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      TipPrint Design Tokens — Componentes básicos de tema
      CLEAR (light) / RAW TERMINAL (dark) via tokens tipprint_*
      Fonte única: design/tipprint-tokens.json
    -->

    <!-- ============ BOTÕES ============ -->

    <!-- Pílula, filled, altura mínima 48dp -->
    <style name="Widget.TipPrint.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/tipprint_on_primary</item>
    </style>

    <!-- Pílula, contorno -->
    <style name="Widget.TipPrint.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/tipprint_ink</item>
    </style>

    <!-- Pílula, tonal -->
    <style name="Widget.TipPrint.Button.Tonal" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/tipprint_on_primary_container</item>
    </style>

    <!-- ============ CARD ============ -->

    <style name="Widget.TipPrint.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/tipprint_surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="strokeColor">@color/tipprint_outline</item>
    </style>

    <!-- ============ INPUT ============ -->

    <style name="Widget.TipPrint.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tipprint_ink</item>
        <item name="android:textColorHint">@color/tipprint_ink_muted</item>
    </style>

    <!-- ============ CHIP ============ -->

    <style name="Widget.TipPrint.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/tipprint_ink</item>
        <item name="chipBackgroundColor">@color/tipprint_surface_card</item>
        <item name="chipStrokeColor">@color/tipprint_outline</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TipPrint.Pill</item>
    </style>

    <!-- ============ SHAPES ============ -->

    <style name="ShapeAppearance.TipPrint.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.TipPrint.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.TipPrint.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="ShapeAppearance.TipPrint.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>

</resources>